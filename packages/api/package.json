{
  "name": "@stewardledger/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "lint": "biome lint src",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "test": "ENV_FILE=../../.env.test vitest run",
    "test:watch": "ENV_FILE=../../.env.test vitest",
