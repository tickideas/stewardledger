    "make-super-admin": "tsx scripts/make-super-admin.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.7.6",
    "@stewardledger/db": "workspace:*",
    "@stewardledger/shared": "workspace:*",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.7.7",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.18.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "usesend-js": "^1.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  }
