{
  "name": "@stewardledger/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && node scripts/check-journal-monotonic.mjs",
    "check:journal": "node scripts/check-journal-monotonic.mjs",
    "test:journal": "node --test scripts/check-journal-monotonic.test.mjs",
    "lint": "biome lint src scripts",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:bootstrap": "tsx src/bootstrap.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@stewardledger/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
