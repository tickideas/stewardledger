{
  "name": "@stewardledger/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "lint": "biome lint src",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:bootstrap": "tsx src/bootstrap.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@stewardledger/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.3"
  }
}
