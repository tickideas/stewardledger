# StewardLedger — local environment template
# Copy to .env and fill in.

# Database (Postgres 17)
DATABASE_URL=postgresql://stewardledger:stewardledger@localhost:5432/stewardledger

# Auth
AUTH_SECRET=change-me-to-a-32-byte-random-string

# URLs (local dev defaults)
PUBLIC_API_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_DOMAIN=localhost
PUBLIC_TENANT_DOMAIN=localhost
VITE_API_URL=http://localhost:3000

# useSend (transactional email; optional in dev — emails are logged)
USESEND_API_KEY=
USESEND_API_URL=

# Object storage (S3-compatible; optional in dev)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=stewardledger-dev

# Logging
LOG_LEVEL=debug
NODE_ENV=development
