# StewardLedger — local environment template
# Copy to .env and fill in.

# Database (Postgres 17)
DATABASE_URL=postgresql://stewardledger:stewardledger@localhost:5432/stewardledger

# Auth
AUTH_SECRET=change-me-to-a-32-byte-random-string

# URLs (local dev defaults)
PUBLIC_API_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_DOMAIN=localhost
PUBLIC_TENANT_DOMAIN=localhost

# Dokploy / production examples (reference only; set these in Dokploy, not .env)
# Replace values in Dokploy and do not commit real secrets.
# Optional but useful when one Docker host runs multiple Compose projects.
COMPOSE_PROJECT_NAME=stewardledger-prod
POSTGRES_USER=stewardledger
POSTGRES_PASSWORD=replace-in-dokploy
POSTGRES_DB=stewardledger
# In Dokploy, DATABASE_URL should point at the Compose Postgres service, for example:
# postgresql://stewardledger:replace-in-dokploy@stewardledger-postgres:5432/stewardledger
PORT=3000
HOST=0.0.0.0

# useSend (transactional email; optional in dev — emails are logged)
USESEND_API_KEY=
USESEND_API_URL=

# Object storage for imports (local filesystem backend in Phase 6)
# Relative paths are resolved from the repository root.
STORAGE_ROOT=.stewardledger-storage

# Future S3-compatible backend settings (not used by the Phase 6 FS adapter)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=stewardledger-dev

# Logging
LOG_LEVEL=debug
NODE_ENV=development
