{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "AUTH_SECRET",
    "PUBLIC_APP_URL",
    "PUBLIC_API_URL",
    "PUBLIC_APP_DOMAIN",
    "PUBLIC_TENANT_DOMAIN",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
